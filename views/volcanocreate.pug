extends layout

block content
  h1= title

  form#volcanoForm(action="/resource/volcanoes" method="POST")
    div.mb-3
      label.volcanoAttr.me-2(for="volcano_name") Name
      input#volcano_name(type="text" name="volcano_name" required)
    div.mb-3
      label.volcanoAttr.me-2(for="country") Country
      input#country(type="text" name="country" required)
    div.mb-3
      label.volcanoAttr.me-2(for="elevation") Elevation (m)
      input#elevation(type="number" name="elevation" required)
    button.btn.btn-primary(type="submit") Create Volcano

  script.
    const form = document.getElementById('volcanoForm');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new URLSearchParams(new FormData(form))
        });

        if (!response.ok) {
          throw new Error(`Server returned ${response.status}`);
        }

        alert('Volcano created successfully!');
        form.reset();
      } catch (error) {
        alert('Create failed: ' + error.message);
      }
    });