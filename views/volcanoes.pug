extends layout

block content
  h1= title

  div(class="container-fluid")
    div(class="row")
      each item, index in results
        div(class="col-sm-2", onclick=`buy(${index})`)
          p Name: #{item.volcano_name}
          p Country: #{item.country}
          p Elevation: #{item.elevation} meters

  script.
    function buy(index) {
      alert(`You purchased item ${index}.`);
    }