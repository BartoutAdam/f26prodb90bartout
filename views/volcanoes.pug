extends layout

block content
  main.container(style="max-width: 860px")
    header.d-flex.flex-wrap.justify-content-between.align-items-center.gap-3.mb-4
      h1.mb-0 Volcanoes
      a.btn.btn-primary(href="/volcanoes/create") Create Volcano

    ul.list-group.shadow-sm
      each item in results
        li.list-group-item.d-flex.flex-wrap.align-items-center.justify-content-between.gap-3.py-3
          div
            strong.d-block= item.volcano_name
            small.text-muted= item.country
          div.d-flex.flex-wrap.gap-2
            a.btn.btn-outline-primary.btn-sm(href=`/volcanoes/detail?id=${item._id}`) Detail
            a.btn.btn-outline-secondary.btn-sm(href=`/volcanoes/update?id=${item._id}`) Update
            a.btn.btn-outline-danger.btn-sm(href=`/volcanoes/delete?id=${item._id}`) Delete
      else
        li.list-group-item No volcanoes yet.