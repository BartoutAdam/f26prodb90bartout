extends layout

block content
  h1= title
  p Welcome to Adam's Assignment 10
  button(type="button", class="btn btn-secondary", onclick="reduce()") Sample Button
  div(id="use") take some away

  script.
    let current = 11;
    let quantity = 2;

    function reduce() {
      current -= quantity;
      if (current < 0) {
        current = 0;
      }
      document.getElementById("use").textContent =
        `Reduced by ${quantity} to ${current}`;
    }

      a(href="/volcanoes") View volcanoes
      